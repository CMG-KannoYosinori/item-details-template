{
  "name": "item-details-template",
  "version": "1.0.0",
  "description": "もらため商品詳細 HTML テンプレート（作成者用ツール）",
  "private": true,
  "volta": {
    "node": "18.16.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch:sass": "sass --no-source-map --watch 00000html/src/styles/:00000html/dist/styles/",
    "watch": "npm run watch:sass",
    "format:eslint": "eslint 00000html/dist/**/*.js --fix",
    "format:prettier": "prettier --write 00000html/dist/**/*.js",
    "format:stylelint:sass": "stylelint '00000html/src/**/*.scss' --fix",
    "format": "npm run format:eslint && npm run format:prettier && npm run format:stylelint:sass",
    "build:sass": "sass --no-source-map 00000html/src/styles/:00000html/dist/styles",
    "build": "npm run format && npm run build:sass"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.8.0",
    "globals": "^16.2.0",
    "lint-staged": "^13.2.2",
    "prettier": "^2.8.8",
    "sass": "^1.62.1",
    "stylelint": "^15.6.2",
    "stylelint-config-recess-order": "^4.0.0",
    "stylelint-config-standard": "^33.0.0",
    "stylelint-config-standard-scss": "^9.0.0",
    "stylelint-prettier": "^3.0.0",
    "stylelint-scss": "^5.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
